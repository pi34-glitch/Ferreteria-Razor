@page
@model FerreteriaRazor.Pages.Ventas.IndexModel
@using FerreteriaRazor.Models
@using System.Text.Json

@{
    ViewData["Title"] = "Historial de ventas";
    ViewData["MenuActivo"] = "HistorialVentas";

    var opcionesJson = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var ventasJson = JsonSerializer.Serialize(
        Model.Ventas.Select(v => new
        {
            v.Id,
            FechaTexto = v.Fecha.ToLocalTime().ToString("dd/MM/yyyy"),
            HoraTexto = v.Fecha.ToLocalTime().ToString("HH:mm"),
            FechaOrden = v.Fecha.Ticks,
            Sucursal = v.Sucursal.Nombre,
            UsuarioNombre = v.Usuario.UserName ?? v.Usuario.Email ?? "Usuario",
            UsuarioEmail = v.Usuario.Email,
            Productos = v.Detalles.Select(d => new
            {
                d.Cantidad,
                Nombre = d.Producto.Nombre,
                d.PrecioUnitario
            }),
            MetodoPago = (int)v.MetodoPago,
            v.Total
        }),
        opcionesJson);
}

<link rel="stylesheet" href="~/js/tablas/ventas-tabla/ventas-tabla.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="h3 mb-1">
            Historial de ventas
        </h1>

        <p class="text-muted mb-0">
            Consulta las ventas registradas, usuarios y métodos de pago.
        </p>
    </div>

    <a asp-page="./Nueva"
       class="btn btn-primary">

        <i class="bi bi-cart-plus me-1"></i>
        Nueva venta

    </a>

</div>

@if (TempData["MensajeExito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <form method="get"
              class="row g-3 align-items-end">

            @if (Model.EsAdministrador)
            {
                <div class="col-md-4">

                    <label asp-for="SucursalId"
                           class="form-label">
                        Sucursal
                    </label>

                    <select asp-for="SucursalId"
                            asp-items="Model.ListaSucursales"
                            class="form-select">
                    </select>

                </div>
            }

            <div class="col-md-3">

                <label asp-for="FechaDesde"
                       class="form-label">
                    Desde
                </label>

                <input asp-for="FechaDesde"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-3">

                <label asp-for="FechaHasta"
                       class="form-label">
                    Hasta
                </label>

                <input asp-for="FechaHasta"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-auto">

                <button type="submit"
                        class="btn btn-dark">

                    <i class="bi bi-funnel me-1"></i>
                    Filtrar

                </button>

                <a asp-page="./Index"
                   class="btn btn-light">

                    Limpiar

                </a>

            </div>

        </form>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        @if (!Model.Ventas.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-receipt fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No hay ventas registradas
                </h4>

                <p class="text-muted mb-0">
                    Registra una venta o modifica los filtros seleccionados.
                </p>

            </div>
        }
        else
        {
            <div id="ventas-tabla-root"
                 data-detalle-url-base="@Url.Page("./Detalle")?id=">
            </div>

            <script type="application/json" id="ventas-data">@Html.Raw(ventasJson)</script>
        }

    </div>

</div>

@section Scripts {
    <script src="~/js/tablas/ventas-tabla/ventas-tabla.js" asp-append-version="true"></script>
}