@page
@model FerreteriaRazor.Pages.Ventas.IndexModel
@using FerreteriaRazor.Models

@{
    ViewData["Title"] = "Historial de ventas";
    ViewData["MenuActivo"] = "HistorialVentas";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="h3 mb-1">
            Historial de ventas
        </h1>

        <p class="text-muted mb-0">
            Consulta las ventas registradas, usuarios y métodos de pago.
        </p>
    </div>

    <a asp-page="./Nueva"
       class="btn btn-primary">

        <i class="bi bi-cart-plus me-1"></i>
        Nueva venta

    </a>

</div>

@if (TempData["MensajeExito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body">

        <form method="get"
              class="row g-3 align-items-end">

            @if (Model.EsAdministrador)
            {
                <div class="col-md-4">

                    <label asp-for="SucursalId"
                           class="form-label">
                        Sucursal
                    </label>

                    <select asp-for="SucursalId"
                            asp-items="Model.ListaSucursales"
                            class="form-select">
                    </select>

                </div>
            }

            <div class="col-md-3">

                <label asp-for="FechaDesde"
                       class="form-label">
                    Desde
                </label>

                <input asp-for="FechaDesde"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-3">

                <label asp-for="FechaHasta"
                       class="form-label">
                    Hasta
                </label>

                <input asp-for="FechaHasta"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-auto">

                <button type="submit"
                        class="btn btn-dark">

                    <i class="bi bi-funnel me-1"></i>
                    Filtrar

                </button>

                <a asp-page="./Index"
                   class="btn btn-light">

                    Limpiar

                </a>

            </div>

        </form>

    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-body">

        @if (!Model.Ventas.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-receipt fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No hay ventas registradas
                </h4>

                <p class="text-muted mb-0">
                    Registra una venta o modifica los filtros seleccionados.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>N.º</th>
                            <th>Fecha</th>
                            <th>Sucursal</th>
                            <th>Usuario</th>
                            <th>Productos</th>
                            <th>Método de pago</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">
                                Acciones
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var venta in Model.Ventas)
                        {
                            <tr>

                                <td>
                                    <span class="fw-semibold">
                                        #@venta.Id
                                    </span>
                                </td>

                                <td>
                                    <div>
                                        @(venta.Fecha.ToLocalTime().ToString("dd/MM/yyyy"))
                                    </div>

                                    <small class="text-muted">
                                        @(venta.Fecha.ToLocalTime().ToString("HH:mm"))
                                    </small>
                                </td>

                                <td>
                                    <i class="bi bi-shop me-1 text-muted"></i>
                                    @venta.Sucursal.Nombre
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">

                                        <i class="bi bi-person-circle fs-5 me-2 text-muted"></i>

                                        <div>
                                            <div class="fw-semibold">
                                                @(venta.Usuario.UserName
                                                    ?? venta.Usuario.Email
                                                    ?? "Usuario")
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(
                                                venta.Usuario.Email)
                                                && venta.Usuario.Email
                                                    != venta.Usuario.UserName)
                                            {
                                                <small class="text-muted">
                                                    @venta.Usuario.Email
                                                </small>
                                            }
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    @foreach (var detalle in venta.Detalles)
                                    {
                                        <div class="mb-1">

                                            <span class="fw-semibold">
                                                @detalle.Cantidad ×
                                            </span>

                                            @detalle.Producto.Nombre

                                            <small class="text-muted">
                                                (@detalle.PrecioUnitario.ToString("N2"))
                                            </small>

                                        </div>
                                    }
                                </td>

                                <td>
                                    @switch (venta.MetodoPago)
                                    {
                                        case MetodoPago.Efectivo:

                                            <span class="badge bg-success">

                                                <i class="bi bi-cash-stack me-1"></i>
                                                Efectivo

                                            </span>

                                            break;

                                        case MetodoPago.QR:

                                            <span class="badge bg-primary">

                                                <i class="bi bi-qr-code me-1"></i>
                                                QR

                                            </span>

                                            break;

                                        case MetodoPago.Tarjeta:

                                            <span class="badge bg-dark">

                                                <i class="bi bi-credit-card me-1"></i>
                                                Tarjeta

                                            </span>

                                            break;

                                        default:

                                            <span class="badge bg-secondary">

                                                <i class="bi bi-question-circle me-1"></i>
                                                No especificado

                                            </span>

                                            break;
                                    }
                                </td>

                                <td class="text-end">

                                    <span class="fw-bold">
                                        Bs @venta.Total.ToString("N2")
                                    </span>

                                </td>
                                <td class="text-end">

                                    <a asp-page="./Detalle"
                                    asp-route-id="@venta.Id"
                                    class="btn btn-outline-primary btn-sm"
                                    title="Ver comprobante"
                                    aria-label="Ver comprobante">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>