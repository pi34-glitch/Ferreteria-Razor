@page
@model FerreteriaRazor.Pages.Ventas.NuevaModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    ViewData["Title"] = "Nueva venta";
    ViewData["MenuActivo"] = "NuevaVenta";

    var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<link rel="stylesheet" href="~/js/nueva-venta/nueva-venta.css" asp-append-version="true" />

<div class="row justify-content-center">

    <div class="col-lg-9">

        <div class="mb-4">
            <h1 class="h3 mb-1">
                Registrar venta
            </h1>

            <p class="text-muted mb-0">
                Agrega los productos, revisa el total y confirma la venta.
                El inventario se descuenta automáticamente.
            </p>
        </div>

        @if (TempData["MensajeExito"] is not null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle me-2"></i>

                @TempData["MensajeExito"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Cerrar">
                </button>

            </div>
        }

        <div id="nueva-venta-root"
             data-antiforgery-token="@token"
             data-nombre-sucursal="@Model.NombreSucursal"
             data-productos-url="@Url.Page(null, "Productos")"
             data-confirmar-url="@Url.Page(null, "Confirmar")"
             data-detalle-url-base="@Url.Page("Detalle")?id="
             data-cancelar-url="@Url.Page("/Index")">
        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/nueva-venta/nueva-venta.js" asp-append-version="true"></script>
}
