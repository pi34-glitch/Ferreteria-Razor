@page
@model FerreteriaRazor.Pages.Ventas.DetalleModel
@using FerreteriaRazor.Models

@{
    ViewData["Title"] = "Comprobante de venta";

    string nombreUsuario =
        Model.Venta.Usuario.UserName
        ?? Model.Venta.Usuario.Email
        ?? "Usuario";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">

    <div>
        <h1 class="h3 mb-1">
            Comprobante de venta
        </h1>

        <p class="text-muted mb-0">
            Información completa de la operación registrada.
        </p>
    </div>

    <div class="d-flex gap-2">

        @if (User.IsInRole("Administrador") ||
             User.IsInRole("Gerente"))
        {
            <a asp-page="./Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left me-1"></i>
                Volver al historial

            </a>
        }
        else
        {
            <a asp-page="./MisVentas"
               class="btn btn-light">

                <i class="bi bi-arrow-left me-1"></i>
                Volver a mis ventas

            </a>
        }

        <button type="button"
                class="btn btn-primary"
                onclick="window.print()">

            <i class="bi bi-printer me-1"></i>
            Imprimir

        </button>

    </div>

</div>

<div class="card border-0 shadow-sm comprobante">

    <div class="card-body p-4 p-md-5">

        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">

            <div>
                <div class="d-flex align-items-center gap-3 mb-2">

                    <div class="rounded-3 bg-warning-subtle p-3">
                        <i class="bi bi-tools fs-3 text-warning"></i>
                    </div>

                    <div>
                        <h2 class="h4 mb-0">
                            FERRETERÍA
                        </h2>

                        <span class="text-muted">
                            Comprobante de venta
                        </span>
                    </div>

                </div>
            </div>

            <div class="text-end">

                <span class="text-muted d-block">
                    Venta
                </span>

                <span class="fs-4 fw-bold">
                    #@Model.Venta.Id
                </span>

            </div>

        </div>

        <div class="row g-4 mb-5">

            <div class="col-md-6">

                <h3 class="h6 text-uppercase text-muted mb-3">
                    Información de la venta
                </h3>

                <dl class="row mb-0">

                    <dt class="col-sm-4">
                        Fecha
                    </dt>

                    <dd class="col-sm-8">
                        @Model.Venta.Fecha
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy HH:mm")
                    </dd>

                    <dt class="col-sm-4">
                        Sucursal
                    </dt>

                    <dd class="col-sm-8">
                        <i class="bi bi-shop me-1 text-muted"></i>
                        @Model.Venta.Sucursal.Nombre
                    </dd>

                    <dt class="col-sm-4">
                        Usuario
                    </dt>

                    <dd class="col-sm-8">
                        <i class="bi bi-person-circle me-1 text-muted"></i>
                        @nombreUsuario
                    </dd>

                </dl>

            </div>

            <div class="col-md-6">

                <h3 class="h6 text-uppercase text-muted mb-3">
                    Información de pago
                </h3>

                <dl class="row mb-0">

                    <dt class="col-sm-5">
                        Método
                    </dt>

                    <dd class="col-sm-7">

                        @switch (Model.Venta.MetodoPago)
                        {
                            case MetodoPago.Efectivo:

                                <span class="badge bg-success">
                                    <i class="bi bi-cash-stack me-1"></i>
                                    Efectivo
                                </span>

                                break;

                            case MetodoPago.QR:

                                <span class="badge bg-primary">
                                    <i class="bi bi-qr-code me-1"></i>
                                    QR
                                </span>

                                break;

                            case MetodoPago.Tarjeta:

                                <span class="badge bg-dark">
                                    <i class="bi bi-credit-card me-1"></i>
                                    Tarjeta
                                </span>

                                break;

                            default:

                                <span class="badge bg-secondary">
                                    No especificado
                                </span>

                                break;
                        }

                    </dd>

                    <dt class="col-sm-5">
                        Estado
                    </dt>

                    <dd class="col-sm-7">
                        <span class="badge bg-success-subtle text-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Completada
                        </span>
                    </dd>

                </dl>

            </div>

        </div>

        <div class="table-responsive mb-4">

            <table class="table align-middle">

                <thead class="table-light">

                    <tr>
                        <th>Producto</th>
                        <th>Código</th>
                        <th class="text-center">Cantidad</th>
                        <th class="text-end">Precio unitario</th>
                        <th class="text-end">Subtotal</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var detalle in Model.Venta.Detalles)
                    {
                        <tr>

                            <td>
                                <span class="fw-semibold">
                                    @detalle.Producto.Nombre
                                </span>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @detalle.Producto.Codigo
                                </span>
                            </td>

                            <td class="text-center">
                                @detalle.Cantidad
                            </td>

                            <td class="text-end">
                                Bs @detalle.PrecioUnitario.ToString("N2")
                            </td>

                            <td class="text-end fw-semibold">
                                Bs @detalle.Subtotal.ToString("N2")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="row justify-content-end">

            <div class="col-md-5 col-lg-4">

                <div class="border-top pt-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <span class="fs-5 fw-semibold">
                            Total
                        </span>

                        <span class="fs-4 fw-bold">
                            Bs @Model.Venta.Total.ToString("N2")
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <div class="border-top mt-5 pt-4 text-center text-muted">

            <p class="mb-1">
                Gracias por su compra.
            </p>

            <small>
                Este comprobante fue generado por el sistema de gestión de la ferretería.
            </small>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        // La impresión se ejecuta con window.print().
    </script>
}