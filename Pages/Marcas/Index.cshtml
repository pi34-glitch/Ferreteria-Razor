@page
@model FerreteriaRazor.Pages.Marcas.IndexModel

@{
    ViewData["Title"] = "Marcas";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="h3 mb-1">Marcas</h1>

        <p class="text-muted mb-0">
            Administra las marcas disponibles para los productos.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn-primary-ferreteria">

        <i class="bi bi-plus-lg"></i>
        Nueva marca

    </a>

</div>
@if (TempData["MensajeExito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        <i class="bi bi-check-circle me-2"></i>
        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show"
         role="alert">

        <i class="bi bi-exclamation-circle me-2"></i>
        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}
<div class="content-panel">

    @if (!Model.Marcas.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-award fs-1 text-muted"></i>

            <h4 class="mt-3">
                No hay marcas registradas
            </h4>

            <p class="text-muted">
                Registra una marca para poder asignarla a los productos.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead>
                    <tr>
                        <th>Marca</th>
                        <th>Descripción</th>
                        <th>Productos</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var marca in Model.Marcas)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    <div class="icon-box">
                                        <i class="bi bi-award-fill"></i>
                                    </div>

                                    <span class="fw-semibold">
                                        @marca.Nombre
                                    </span>

                                </div>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(marca.Descripcion)
                                    ? "Sin descripción"
                                    : marca.Descripcion)
                            </td>

                            <td>
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-box-seam me-1"></i>
                                    @marca.Productos.Count
                                </span>
                            </td>

                            <td>
                                @if (marca.Activa)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Inactiva
                                    </span>
                                }
                            </td>

                            <td class="text-end">

                                <a asp-page="./Details"
                                   asp-route-id="@marca.Id"
                                   class="btn btn-light btn-sm"
                                   title="Ver detalles">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@marca.Id"
                                   class="btn btn-warning btn-sm"
                                   title="Editar">

                                    <i class="bi bi-pencil"></i>

                                </a>
                                <a asp-page="./Delete"
                                    asp-route-id="@marca.Id"
                                    class="btn btn-danger btn-sm"
                                    title="Eliminar"
                                    aria-label="Eliminar @marca.Nombre">

                                        <i class="bi bi-trash"></i>
                                </a>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>