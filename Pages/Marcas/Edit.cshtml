@page "{id:int}"
@model FerreteriaRazor.Pages.Marcas.EditModel

@{
    ViewData["Title"] = "Editar marca";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="page-content-header">
            <div>
                <h1 class="page-content-title">Editar marca</h1>

                <p class="page-content-description">
                    Modifica la información y disponibilidad de la marca.
                </p>
            </div>

            <a asp-page="./Index" class="btn btn-light">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>
        </div>

        <div class="content-panel">
            <div class="p-4">

                <form method="post">

                    <input type="hidden" asp-for="Input.Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Nombre"
                               class="form-label">
                        </label>

                        <input asp-for="Input.Nombre"
                               class="form-control" />

                        <span asp-validation-for="Input.Nombre"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Descripcion"
                               class="form-label">
                        </label>

                        <textarea asp-for="Input.Descripcion"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Input.Descripcion"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="Input.Activa"
                               class="form-check-input" />

                        <label asp-for="Input.Activa"
                               class="form-check-label">
                        </label>
                    </div>

                    <div class="alert alert-light border">
                        <i class="bi bi-info-circle me-2"></i>

                        Una marca inactiva no aparecerá al registrar nuevos
                        productos, pero los productos existentes conservarán
                        su información.
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-page="./Index"
                           class="btn btn-light">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn-primary-ferreteria">

                            <i class="bi bi-check-lg"></i>
                            Guardar cambios
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}