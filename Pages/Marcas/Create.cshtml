@page
@model FerreteriaRazor.Pages.Marcas.CreateModel

@{
    ViewData["Title"] = "Nueva marca";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="page-content-header">

            <div>
                <h1 class="page-content-title">
                    Nueva marca
                </h1>

                <p class="page-content-description">
                    Registra una marca para asignarla a los productos.
                </p>
            </div>

            <a asp-page="./Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>

        </div>

        <div class="content-panel">

            <div class="p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="mb-3">

                        <label asp-for="Input.Nombre"
                               class="form-label">
                        </label>

                        <input asp-for="Input.Nombre"
                               class="form-control"
                               placeholder="Ejemplo: Bosch" />

                        <span asp-validation-for="Input.Nombre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Input.Descripcion"
                               class="form-label">
                        </label>

                        <textarea asp-for="Input.Descripcion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Descripción de la marca">
                        </textarea>

                        <span asp-validation-for="Input.Descripcion"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-page="./Index"
                           class="btn btn-light">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn-primary-ferreteria">

                            <i class="bi bi-check-lg"></i>
                            Registrar marca

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}