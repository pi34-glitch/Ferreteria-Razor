@page
@model FerreteriaRazor.Pages.Productos.IndexModel

@{
    ViewData["Title"] = "Productos";
}

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="page-heading">

    <div>
        @if (Model.EsAdministrador)
        {
            <h1 class="h3 mb-1">Catálogo de productos</h1>

            <p class="text-muted">
                Administra productos, precios, categorías, marcas e imágenes.
            </p>
        }
        else if (Model.EsGerente)
        {
            <h1 class="h3 mb-1">Productos de mi sucursal</h1>

            <p class="text-muted">
                Consulta productos y administra el inventario de tu sucursal.
            </p>
        }
        else
        {
            <h1 class="h3 mb-1">Productos disponibles</h1>

            <p class="text-muted">
                Consulta productos, precios y existencias de tu sucursal.
            </p>
        }
    </div>
    @if (Model.EsAdministrador || Model.EsGerente)
    {
        <div class="ms-auto">

            <a asp-page="./Create"
               class="btn btn-primary btn-modern">

                <i class="bi bi-plus-lg"></i>
                Nuevo producto

            </a>

        </div>
    }
</div>

<div class="content-card">

    @if (!Model.Productos.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <h3>No hay productos registrados</h3>

            <p>
                Registra el primer producto para comenzar a administrar
                el inventario.
            </p>

            <a asp-page="./Create"
               class="btn btn-primary btn-modern">

                <i class="bi bi-plus-lg"></i>
                Registrar producto

            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-modern align-middle">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Código</th>
                        <th>Categoría</th>
                        <th>Marca</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var producto in Model.Productos)
                    {   
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrWhiteSpace(producto.ImagenUrl))
                                    {
                                        <img src="@producto.ImagenUrl"
                                            alt="@producto.Nombre"
                                            class="product-image" />
                                    }
                                    else
                                    {
                                        <div class="product-image d-grid place-items-center">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }

                                    <div>
                                        <strong class="d-block">
                                            @producto.Nombre
                                        </strong>

                                        <small class="text-muted">
                                            @(string.IsNullOrWhiteSpace(producto.Descripcion)
                                                ? "Sin descripción"
                                                : producto.Descripcion)
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @(string.IsNullOrWhiteSpace(producto.Codigo)
                                        ? "—"
                                        : producto.Codigo)
                                </span>
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(producto.Categoria)
                                    ? "Sin categoría"
                                    : producto.Categoria)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(producto.Marca)
                                    ? "Sin marca"
                                    : producto.Marca)
                            </td>

                            <td>
                                <strong>
                                    Bs @producto.Precio.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @if (producto.Stock.HasValue)
                                {
                                    <div class="fw-semibold">
                                        @producto.Stock
                                    </div>

                                    @if (producto.Stock == 0)
                                    {
                                        <span class="badge bg-danger">
                                            Agotado
                                        </span>
                                    }
                                    else if (producto.Stock <= producto.StockMinimo)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Stock bajo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            Disponible
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>

                            <td>
                                @if (producto.Activo)
                                {
                                    <span class="status-badge status-active">
                                        <i class="bi bi-circle-fill"
                                        style="font-size: 6px;">
                                        </i>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="bi bi-circle-fill"
                                        style="font-size: 6px;">
                                        </i>
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-page="./Details"
                                    asp-route-id="@producto.ProductoId"
                                    class="btn btn-light btn-sm"
                                    title="Ver detalles"
                                    aria-label="Ver detalles">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    @if (Model.EsAdministrador)
                                    {
                                        <a asp-page="./Edit"
                                        asp-route-id="@producto.ProductoId"
                                        class="btn btn-warning btn-sm"
                                        title="Editar producto"
                                        aria-label="Editar producto">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-page="./Delete"
                                        asp-route-id="@producto.ProductoId"
                                        class="btn btn-danger btn-sm"
                                        title="Eliminar producto"
                                        aria-label="Eliminar producto">

                                            <i class="bi bi-trash"></i>

                                        </a>
                                    }
                                    else if (Model.EsGerente &&
                                            producto.InventarioSucursalId.HasValue)
                                    {
                                        <a asp-page="/Inventario/Editar"
                                        asp-route-id="@producto.InventarioSucursalId"
                                        class="btn btn-warning btn-sm"
                                        title="Editar inventario"
                                        aria-label="Editar inventario">

                                            <i class="bi bi-box-seam"></i>

                                        </a>
                                    }

                                </div>
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>