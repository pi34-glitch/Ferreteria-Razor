@page
@model FerreteriaRazor.Pages.Productos.IndexModel

@{
    ViewData["Title"] = "Productos";
}

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="page-heading">

    <div>
        <h2>Inventario de productos</h2>

        <p>
            Administra los productos, precios, stock e imágenes.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn btn-primary btn-modern">

        <i class="bi bi-plus-lg"></i>
        Nuevo producto

    </a>

</div>

<div class="content-card">

    @if (!Model.Productos.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <h3>No hay productos registrados</h3>

            <p>
                Registra el primer producto para comenzar a administrar
                el inventario.
            </p>

            <a asp-page="./Create"
               class="btn btn-primary btn-modern">

                <i class="bi bi-plus-lg"></i>
                Registrar producto

            </a>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-modern align-middle">

                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Código</th>
                        <th>Categoría</th>
                        <th>Marca</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var producto in Model.Productos)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-3">

                                    @if (!string.IsNullOrWhiteSpace(
                                        producto.ImagenUrl))
                                    {
                                        <img src="@producto.ImagenUrl"
                                             alt="@producto.Nombre"
                                             class="product-image" />
                                    }
                                    else
                                    {
                                        <div class="product-image d-grid
                                                    place-items-center">
                                            <i class="bi bi-image text-muted"></i>
                                        </div>
                                    }

                                    <div>
                                        <strong class="d-block">
                                            @producto.Nombre
                                        </strong>

                                        <small class="text-muted">
                                            @(
                                                string.IsNullOrWhiteSpace(
                                                    producto.Descripcion)
                                                    ? "Sin descripción"
                                                    : producto.Descripcion
                                            )
                                        </small>
                                    </div>

                                </div>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @(producto.Codigo ?? "—")
                                </span>
                            </td>

                            <td>
                                @(producto.Categoria?.Nombre ?? "Sin categoría")
                            </td>

                            <td>
                                @(producto.Marca?.Nombre ?? "Sin marca")
                            </td>

                            <td>
                                <strong>
                                    Bs @producto.Precio.ToString("N2")
                                </strong>
                            </td>

                            <td>
                                @if (producto.Activo)
                                {
                                    <span class="status-badge status-active">
                                        <i class="bi bi-circle-fill"
                                           style="font-size: 6px;">
                                        </i>
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="bi bi-circle-fill"
                                           style="font-size: 6px;">
                                        </i>
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td class="text-end">

                                <a asp-page="./Details"
                                   asp-route-id="@producto.Id"
                                   class="btn btn-sm btn-light action-button"
                                   title="Ver detalles">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@producto.Id"
                                   class="btn btn-sm btn-warning action-button"
                                   title="Editar">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@producto.Id"
                                   class="btn btn-sm btn-danger action-button"
                                   title="Eliminar">

                                    <i class="bi bi-trash"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>