@page
@model FerreteriaRazor.Pages.Productos.IndexModel
@using System.Text.Json

@{
    ViewData["Title"] = "Productos";

    var opcionesJson = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var productosJson = JsonSerializer.Serialize(Model.Productos, opcionesJson);

    // Details/Edit/Delete e Inventario/Editar usan una ruta con el id como
    // segmento (@page "{id:int}"), no como query string. Url.Page no puede
    // generar la URL sin el id, así que se genera con id=0 y se recorta el
    // "0" final para quedarnos con la base y poder concatenar el id real
    // desde React (?id= habría producido un enlace roto).
    string ConstruirUrlBase(string pagina)
    {
        var url = Url.Page(pagina, new { id = 0 })!;
        return url.Substring(0, url.Length - 1);
    }

    var detailsUrlBase = ConstruirUrlBase("./Details");
    var editUrlBase = ConstruirUrlBase("./Edit");
    var deleteUrlBase = ConstruirUrlBase("./Delete");
    var editarInventarioUrlBase = ConstruirUrlBase("/Inventario/Editar");
}

<link rel="stylesheet" href="~/js/tablas/productos-tabla/productos-tabla.css" asp-append-version="true" />

@if (TempData["Mensaje"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-check-circle-fill me-2"></i>

        @TempData["Mensaje"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm"
         role="alert">

        <i class="bi bi-exclamation-triangle-fill me-2"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="page-heading">

    <div>
        @if (Model.EsAdministrador)
        {
            <h1 class="h3 mb-1">Catálogo de productos</h1>

            <p class="text-muted">
                Administra productos, precios, categorías, marcas e imágenes.
            </p>
        }
        else if (Model.EsGerente)
        {
            <h1 class="h3 mb-1">Productos de mi sucursal</h1>

            <p class="text-muted">
                Consulta productos y administra el inventario de tu sucursal.
            </p>
        }
        else
        {
            <h1 class="h3 mb-1">Productos disponibles</h1>

            <p class="text-muted">
                Consulta productos, precios y existencias de tu sucursal.
            </p>
        }
    </div>
    @if (Model.EsAdministrador || Model.EsGerente)
    {
        <div class="ms-auto">

            <a asp-page="./Create"
               class="btn btn-primary btn-modern">

                <i class="bi bi-plus-lg"></i>
                Nuevo producto

            </a>

        </div>
    }
</div>

<div class="content-card">

    @if (!Model.Productos.Any())
    {
        <div class="empty-state">

            <div class="empty-state-icon">
                <i class="bi bi-box-seam"></i>
            </div>

            <h3>No hay productos registrados</h3>

            <p>
                Registra el primer producto para comenzar a administrar
                el inventario.
            </p>

            <a asp-page="./Create"
               class="btn btn-primary btn-modern">

                <i class="bi bi-plus-lg"></i>
                Registrar producto

            </a>

        </div>
    }
    else
    {
        <div id="productos-tabla-root"
             data-es-administrador="@Model.EsAdministrador.ToString().ToLowerInvariant()"
             data-es-gerente="@Model.EsGerente.ToString().ToLowerInvariant()"
             data-details-url-base="@detailsUrlBase"
             data-edit-url-base="@editUrlBase"
             data-delete-url-base="@deleteUrlBase"
             data-editar-inventario-url-base="@editarInventarioUrlBase">
        </div>

        <script type="application/json" id="productos-data">@Html.Raw(productosJson)</script>
    }

</div>

@section Scripts {
    <script src="~/js/tablas/productos-tabla/productos-tabla.js" asp-append-version="true"></script>
}