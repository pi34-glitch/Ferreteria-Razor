@page "{id:int}"
@model FerreteriaRazor.Pages.Productos.DetailsModel

@{
    ViewData["Title"] = "Detalles del producto";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-lg-10">

            <div class="card shadow-sm">

                <div class="card-header bg-dark text-white">

                    <h2 class="mb-0">
                        Detalles del producto
                    </h2>

                </div>

                <div class="card-body">

                    <div class="row">

                        <!-- Imagen -->
                        <div class="col-md-4 text-center mb-4">

                            @if (!string.IsNullOrWhiteSpace(
                                Model.Producto.ImagenUrl))
                            {
                                <img src="@Model.Producto.ImagenUrl"
                                     alt="@Model.Producto.Nombre"
                                     class="img-fluid rounded border"
                                     style="max-height: 300px;
                                            object-fit: contain;" />
                            }
                            else
                            {
                                <div class="border rounded bg-light
                                            d-flex align-items-center
                                            justify-content-center"
                                     style="height: 250px;">

                                    <span class="text-muted">
                                        Sin imagen
                                    </span>

                                </div>
                            }

                        </div>

                        <!-- Información general -->
                        <div class="col-md-8">

                            <h3>
                                @Model.Producto.Nombre
                            </h3>

                            <p class="text-muted">
                                @(Model.Producto.Descripcion
                                    ?? "Sin descripción")
                            </p>

                            <dl class="row">

                                <dt class="col-sm-4">
                                    Código
                                </dt>

                                <dd class="col-sm-8">
                                    @(string.IsNullOrWhiteSpace(
                                        Model.Producto.Codigo)
                                            ? "Sin código"
                                            : Model.Producto.Codigo)
                                </dd>

                                <dt class="col-sm-4">
                                    Precio
                                </dt>

                                <dd class="col-sm-8">
                                    Bs @Model.Producto.Precio.ToString("N2")
                                </dd>

                                <dt class="col-sm-4">
                                    Categoría
                                </dt>

                                <dd class="col-sm-8">
                                    @(Model.Producto.Categoria?.Nombre
                                        ?? "Sin categoría")
                                </dd>

                                <dt class="col-sm-4">
                                    Marca
                                </dt>

                                <dd class="col-sm-8">
                                    @(Model.Producto.Marca?.Nombre
                                        ?? "Sin marca")
                                </dd>

                                <dt class="col-sm-4">
                                    Distribuidora
                                </dt>

                                <dd class="col-sm-8">
                                    @(Model.Producto.Distribuidora?.Nombre
                                        ?? "Sin distribuidora")
                                </dd>

                                <dt class="col-sm-4">
                                    Fecha de registro
                                </dt>

                                <dd class="col-sm-8">
                                    @Model.Producto.FechaRegistro
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                </dd>

                                <dt class="col-sm-4">
                                    Estado
                                </dt>

                                <dd class="col-sm-8">

                                    @if (Model.Producto.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </dd>

                                <dt class="col-sm-4">
                                    Stock total
                                </dt>

                                <dd class="col-sm-8">

                                    @{
                                        var stockTotal =
                                            Model.Producto
                                                .InventariosSucursales
                                                .Sum(i => i.Stock);
                                    }

                                    <strong>
                                        @stockTotal unidades
                                    </strong>

                                </dd>

                            </dl>

                        </div>

                    </div>

                    <hr class="my-4" />

                    <!-- Inventario por sucursal -->
                    <div>

                        <div class="d-flex justify-content-between
                                    align-items-center mb-3">

                            <div>

                                <h4 class="mb-1">
                                    Inventario por sucursal
                                </h4>

                                <p class="text-muted mb-0">
                                    Stock disponible y stock mínimo
                                    en cada sucursal.
                                </p>

                            </div>

                            <span class="badge bg-primary">

                                @Model.Producto
                                    .InventariosSucursales
                                    .Count

                                sucursales

                            </span>

                        </div>

                        @if (!Model.Producto
                            .InventariosSucursales
                            .Any())
                        {
                            <div class="alert alert-info">

                                Este producto todavía no fue agregado
                                al inventario de ninguna sucursal.

                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">

                                <table class="table table-bordered
                                              table-hover align-middle">

                                    <thead class="table-light">

                                        <tr>
                                            <th>Sucursal</th>
                                            <th>Stock actual</th>
                                            <th>Stock mínimo</th>
                                            <th>Estado</th>
                                            <th class="text-end">
                                                Acción
                                            </th>
                                        </tr>

                                    </thead>

                                    <tbody>

                                        @foreach (var inventario in
                                            Model.Producto
                                                .InventariosSucursales)
                                        {
                                            <tr>

                                                <td>
                                                    @inventario.Sucursal.Nombre
                                                </td>

                                                <td>
                                                    <strong>
                                                        @inventario.Stock
                                                    </strong>
                                                </td>

                                                <td>
                                                    @inventario.StockMinimo
                                                </td>

                                                <td>

                                                    @if (inventario.Stock == 0)
                                                    {
                                                        <span class="badge
                                                                     bg-danger">
                                                            Sin stock
                                                        </span>
                                                    }
                                                    else if (
                                                        inventario.Stock
                                                        <= inventario.StockMinimo)
                                                    {
                                                        <span class="badge
                                                                     bg-warning
                                                                     text-dark">
                                                            Stock bajo
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge
                                                                     bg-success">
                                                            Disponible
                                                        </span>
                                                    }

                                                </td>

                                                <td class="text-end">

                                                    <a asp-page="/Inventario/Editar"
                                                       asp-route-id="@inventario.Id"
                                                       class="btn btn-sm
                                                              btn-outline-primary">

                                                        <i class="bi bi-pencil"></i>
                                                        Editar inventario

                                                    </a>

                                                </td>

                                            </tr>
                                        }

                                    </tbody>

                                </table>

                            </div>
                        }

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-page="./Index"
                           class="btn btn-secondary">

                            Volver

                        </a>

                        <a asp-page="./Edit"
                           asp-route-id="@Model.Producto.Id"
                           class="btn btn-warning">

                            Editar producto

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>