@page
@model FerreteriaRazor.Pages.Distribuidoras.CreateModel

@{
    ViewData["Title"] = "Nueva distribuidora";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="page-content-header">

            <div>
                <h1 class="page-content-title">
                    Nueva distribuidora
                </h1>

                <p class="page-content-description">
                    Registra un proveedor para asignarlo a los productos.
                </p>
            </div>

            <a asp-page="./Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>

        </div>

        <div class="content-panel">

            <div class="p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <div class="row">

                        <div class="col-md-7 mb-3">
                            <label asp-for="Input.Nombre"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Nombre"
                                   class="form-control"
                                   placeholder="Ejemplo: Importadora Central" />

                            <span asp-validation-for="Input.Nombre"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-5 mb-3">
                            <label asp-for="Input.Contacto"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Contacto"
                                   class="form-control"
                                   placeholder="Persona de contacto" />

                            <span asp-validation-for="Input.Contacto"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Telefono"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Telefono"
                                   class="form-control"
                                   placeholder="Ejemplo: 70707070" />

                            <span asp-validation-for="Input.Telefono"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Input.Correo"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Correo"
                                   class="form-control"
                                   type="email"
                                   placeholder="correo@empresa.com" />

                            <span asp-validation-for="Input.Correo"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="col-12 mb-3">
                            <label asp-for="Input.Direccion"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Direccion"
                                   class="form-control"
                                   placeholder="Dirección de la empresa" />

                            <span asp-validation-for="Input.Direccion"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-page="./Index"
                           class="btn btn-light">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn-primary-ferreteria">

                            <i class="bi bi-check-lg"></i>
                            Registrar distribuidora

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}