<!DOCTYPE html>
<html lang="es">
@{
    string paginaActual =
        ViewContext.RouteData.Values["page"]?.ToString()
        ?? string.Empty;

    string menuActivo =
        ViewData["MenuActivo"]?.ToString()
        ?? string.Empty;

    bool EsPagina(string ruta)
    {
        return paginaActual.StartsWith(
            ruta,
            StringComparison.OrdinalIgnoreCase);
    }
}

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Ferretería Pro</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">

            <div class="sidebar-brand">

                <div class="brand-icon">
                    <i class="bi bi-tools"></i>
                </div>

                <div class="brand-text">
                    <span class="brand-title">
                        FERRETERÍA
                    </span>

                    <span class="brand-subtitle">
                        Panel administrativo
                    </span>
                </div>

            </div>

            <!-- MENÚ LATERAL -->
            <nav class="sidebar-nav">

                <!-- PRINCIPAL -->
                <span class="nav-section-title">
                    PRINCIPAL
                </span>

                <a asp-page="/Index"
                class="sidebar-link @(paginaActual == "/Index" ? "active" : "")">

                    <i class="bi bi-grid-1x2-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- CATÁLOGO -->
                <span class="nav-section-title">
                    CATÁLOGO
                </span>

                @if (User.IsInRole("Administrador") ||
                    User.IsInRole("Gerente") ||
                    User.IsInRole("Empleado"))
                {
                    <a asp-page="/Productos/Index"
                    class="sidebar-link @(EsPagina("/Productos") ? "active" : "")">

                        <i class="bi bi-box-seam me-2"></i>

                        @if (User.IsInRole("Administrador"))
                        {
                            <span>Productos</span>
                        }
                        else
                        {
                            <span>Productos de sucursal</span>
                        }

                    </a>
                }

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-page="/Categorias/Index"
                    class="sidebar-link @(EsPagina("/Categorias") ? "active" : "")">

                        <i class="bi bi-tags-fill"></i>

                        <span>
                            Categorías
                        </span>

                    </a>

                    <a asp-page="/Marcas/Index"
                    class="sidebar-link @(EsPagina("/Marcas") ? "active" : "")">

                        <i class="bi bi-award-fill"></i>

                        <span>
                            Marcas
                        </span>

                    </a>

                    <a asp-page="/Distribuidoras/Index"
                    class="sidebar-link @(EsPagina("/Distribuidoras") ? "active" : "")">

                        <i class="bi bi-truck"></i>

                        <span>
                            Distribuidoras
                        </span>

                    </a>
                }


                <!-- INVENTARIO -->
                @if (User.IsInRole("Administrador") ||
                    User.IsInRole("Gerente"))
                {
                    <span class="nav-section-title">
                        INVENTARIO
                    </span>

                    <a asp-page="/Inventario/Index"
                    class="sidebar-link @(EsPagina("/Inventario") ? "active" : "")">

                        <i class="bi bi-boxes"></i>

                        <span>
                            Inventario por sucursal
                        </span>

                    </a>
                }
                    <!-- OPERACIONES -->
                <span class="nav-section-title">
                    OPERACIONES
                </span>
                
                @if (User.IsInRole("Administrador") ||
                    User.IsInRole("Gerente"))
                {
                    <a asp-page="/Ventas/Index"
                    class="sidebar-link @(menuActivo == "HistorialVentas" ? "active" : "")"
                    aria-current="@(menuActivo == "HistorialVentas" ? "page" : null)">

                        <i class="bi bi-cart-check-fill"></i>

                        <span>
                            Historial de ventas
                        </span>

                    </a>
                }
                @if (User.IsInRole("Gerente") ||
                    User.IsInRole("Empleado"))
                {
                    <a asp-page="/Ventas/Nueva"
                    class="sidebar-link @(menuActivo == "NuevaVenta" ? "active" : "")"
                    aria-current="@(menuActivo == "NuevaVenta" ? "page" : null)">

                        <i class="bi bi-receipt-cutoff"></i>

                            <span>
                                Nueva venta
                            </span>
                    </a>
                }
                @if (User.IsInRole("Gerente") ||
                    User.IsInRole("Empleado"))
                {
                    <a asp-page="/Ventas/MisVentas"
                    class="nav-link">

                        <i class="bi bi-receipt-cutoff me-2"></i>
                        Mis ventas

                    </a>
                }

                <!-- ADMINISTRACIÓN -->
                @if (User.IsInRole("Administrador"))
                {
                    <span class="nav-section-title">
                        ADMINISTRACIÓN
                    </span>

                    <a asp-page="/Usuarios/Index"
                    class="sidebar-link @(EsPagina("/Usuarios") ? "active" : "")">

                        <i class="bi bi-people-fill"></i>

                        <span>
                            Usuarios
                        </span>

                    </a>
                }
            </nav>

            <!-- INFORMACIÓN DEL USUARIO EN EL SIDEBAR -->
            <div class="sidebar-footer">

                <div class="user-card">

                    <div class="user-avatar">
                        <i class="bi bi-person-fill"></i>
                    </div>

                    <div class="user-data">

                        <strong>
                            @(User.Identity?.Name ?? "Usuario")
                        </strong>

                        <span>
                            @if (User.IsInRole("Administrador"))
                            {
                                <text>Administrador general</text>
                            }
                            else
                            {
                                @(User.FindFirst("SucursalNombre")?.Value
                                    ?? "Sin sucursal")
                            }
                        </span>

                    </div>

                </div>

            </div>

        </aside>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="app-content">

            <!-- BARRA SUPERIOR -->
            <header class="topbar">

                <div class="topbar-left">

                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button"
                            aria-label="Abrir menú">

                        <i class="bi bi-list"></i>

                    </button>

                    <div>

                        <h1 class="page-title">
                            @ViewData["Title"]
                        </h1>

                        <span class="page-subtitle">
                            Sistema de gestión de ferretería
                        </span>

                    </div>

                </div>

                <div class="topbar-actions">

                    <!-- NOTIFICACIONES -->
                    <button class="topbar-button"
                            type="button"
                            title="Notificaciones">

                        <i class="bi bi-bell"></i>

                        <span class="notification-indicator"></span>

                    </button>

                    <!-- PERFIL DEL USUARIO -->
                    <div class="dropdown">

                        <button class="profile-button dropdown-toggle"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <span class="profile-avatar">

                                <i class="bi bi-person-fill"></i>

                            </span>

                            <span class="profile-info">

                                <strong>
                                    @(User.Identity?.Name ?? "Usuario")
                                </strong>

                                <small>
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <text>Administrador</text>
                                    }
                                    else if (User.IsInRole("Gerente"))
                                    {
                                        <text>Gerente</text>
                                    }
                                    else if (User.IsInRole("Empleado"))
                                    {
                                        <text>Empleado</text>
                                    }
                                    else
                                    {
                                        <text>Usuario</text>
                                    }
                                </small>

                            </span>

                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                            <li class="dropdown-header user-dropdown-header">

                                <div class="user-dropdown-avatar">

                                    <i class="bi bi-person-fill"></i>

                                </div>

                                <div class="user-dropdown-data">

                                    <strong>
                                        @(User.Identity?.Name ?? "Usuario")
                                    </strong>

                                    <span>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <text>Administrador</text>
                                        }
                                        else if (User.IsInRole("Gerente"))
                                        {
                                            <text>Gerente</text>
                                        }
                                        else if (User.IsInRole("Empleado"))
                                        {
                                            <text>Empleado</text>
                                        }
                                    </span>

                                    <small>
                                        @(User.FindFirst("SucursalNombre")?.Value
                                            ?? "Sin sucursal")
                                    </small>

                                </div>

                            </li>

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <span class="dropdown-item disabled">

                                    <i class="bi bi-person me-2"></i>
                                    Mi perfil

                                    <small class="ms-auto">
                                        Próximamente
                                    </small>

                                </span>
                            </li>

                            <li>
                                <span class="dropdown-item disabled">

                                    <i class="bi bi-gear me-2"></i>
                                    Configuración

                                    <small class="ms-auto">
                                        Próximamente
                                    </small>

                                </span>
                            </li>


                            <li>

                                <form method="post"
                                      asp-page="/Account/Logout">

                                    <button type="submit"
                                            class="dropdown-item text-danger">

                                        <i class="bi bi-box-arrow-right me-2"></i>

                                        Cerrar sesión

                                    </button>

                                </form>

                            </li>

                        </ul>

                    </div>

                </div>

            </header>

            <!-- CONTENIDO DE CADA PÁGINA -->
            <main class="main-content">

                @RenderBody()

            </main>

            <!-- PIE DE PÁGINA -->
            <footer class="app-footer">

                <span>
                    © @DateTime.Now.Year Ferretería Llave Nuda
                </span>

                <span>
                    ASP.NET Core Razor Pages
                </span>

            </footer>

        </div>

    </div>

    <!-- FONDO PARA SIDEBAR EN MÓVILES -->
    <div class="sidebar-overlay"
         id="sidebarOverlay">
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>