@page
@model FerreteriaRazor.Pages.Inventario.NuevoProductoModel

@{
    ViewData["Title"] = "Registrar producto nuevo";
}

<div class="row justify-content-center">

    <div class="col-xl-9">

        <div class="page-content-header">

            <div>
                <h1 class="page-content-title">
                    Registrar producto nuevo
                </h1>

                <p class="page-content-description">
                    Crea el producto y agrégalo inmediatamente al inventario de una sucursal.
                </p>
            </div>

            <a asp-page="./Index"
               class="btn btn-light">

                <i class="bi bi-arrow-left"></i>
                Volver

            </a>

        </div>

        <div class="content-panel">

            <div class="p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger" role="alert">
                    </div>

                    <div class="mb-4">

                        <h2 class="h5 mb-1">
                            Información del producto
                        </h2>

                        <p class="text-muted small mb-0">
                            Estos datos serán compartidos por todas las sucursales.
                        </p>

                    </div>

                    <div class="row">

                        <div class="col-md-7 mb-3">

                            <label asp-for="Input.Nombre"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Nombre"
                                   class="form-control"
                                   placeholder="Ejemplo: Taladro Bosch 850 W" />

                            <span asp-validation-for="Input.Nombre"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-5 mb-3">

                            <label asp-for="Input.Precio"
                                   class="form-label">
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    Bs
                                </span>

                                <input asp-for="Input.Precio"
                                       class="form-control"
                                       type="number"
                                       min="0.01"
                                       step="0.01" />

                            </div>

                            <span asp-validation-for="Input.Precio"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-12 mb-3">

                            <label asp-for="Input.Descripcion"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Input.Descripcion"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Descripción general del producto">
                            </textarea>

                            <span asp-validation-for="Input.Descripcion"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label asp-for="Input.CategoriaId"
                                   class="form-label">
                            </label>

                            <select asp-for="Input.CategoriaId"
                                    asp-items="Model.ListaCategorias"
                                    class="form-select">

                                <option value="">
                                    Seleccione una categoría
                                </option>

                            </select>

                            <span asp-validation-for="Input.CategoriaId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label asp-for="Input.MarcaId"
                                   class="form-label">
                            </label>

                            <select asp-for="Input.MarcaId"
                                    asp-items="Model.ListaMarcas"
                                    class="form-select">

                                <option value="">
                                    Seleccione una marca
                                </option>

                            </select>

                            <span asp-validation-for="Input.MarcaId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-4 mb-3">

                            <label asp-for="Input.DistribuidoraId"
                                   class="form-label">
                            </label>

                            <select asp-for="Input.DistribuidoraId"
                                    asp-items="Model.ListaDistribuidoras"
                                    class="form-select">

                                <option value="">
                                    Seleccione una distribuidora
                                </option>

                            </select>

                            <span asp-validation-for="Input.DistribuidoraId"
                                  class="text-danger">
                            </span>

                        </div>
                        
                        <div class="col-md-4 mb-3">

                            <label asp-for="Input.Codigo"
                                class="form-label">
                            </label>

                            <input asp-for="Input.Codigo"
                                class="form-control"
                                placeholder="Ejemplo: TAL-001" />

                            <span asp-validation-for="Input.Codigo"
                                class="text-danger">
                            </span>

                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="mb-4">

                        <h2 class="h5 mb-1">
                            Información del inventario
                        </h2>

                        <p class="text-muted small mb-0">
                            Estos valores pertenecen únicamente a la sucursal seleccionada.
                        </p>

                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.SucursalId"
                                   class="form-label">
                            </label>

                            @if (Model.EsAdministrador)
                            {
                                <select asp-for="Input.SucursalId"
                                        asp-items="Model.ListaSucursales"
                                        class="form-select">

                                    <option value="">
                                        Seleccione una sucursal
                                    </option>

                                </select>
                            }
                            else
                            {
                                <input type="hidden"
                                       asp-for="Input.SucursalId" />

                                <input type="text"
                                       class="form-control"
                                       value="@Model.NombreSucursalGerente"
                                       readonly />
                            }

                            <span asp-validation-for="Input.SucursalId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-3 mb-3">

                            <label asp-for="Input.Stock"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Stock"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="Input.Stock"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-3 mb-3">

                            <label asp-for="Input.StockMinimo"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.StockMinimo"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="Input.StockMinimo"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    @if (!Model.EsAdministrador)
                    {
                        <div class="alert alert-info">

                            <i class="bi bi-building me-2"></i>

                            El producto será registrado únicamente en el inventario de tu sucursal.

                        </div>
                    }

                    <div class="alert alert-light border">

                        <i class="bi bi-image me-2"></i>

                        Después de registrar el producto podrás agregarle una imagen desde el catálogo de productos.

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-page="./Index"
                           class="btn btn-light">

                            Cancelar

                        </a>

                        <button type="submit"
                                class="btn-primary-ferreteria">

                            <i class="bi bi-check-lg"></i>
                            Registrar producto

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}