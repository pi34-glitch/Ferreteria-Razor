@page
@model FerreteriaRazor.Pages.Inventario.IndexModel

@{
    ViewData["Title"] = "Inventario por sucursal";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            Inventario por sucursal
        </h1>

        <p class="text-muted mb-0">
            Consulta y administra las existencias de productos.
        </p>
    </div>

    <div class="dropdown">

        <button class="btn-primary-ferreteria dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

            <i class="bi bi-plus-lg"></i>
            Agregar producto

        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
            @if (User.IsInRole("Administrador"))
            {
                <li>
                    <a asp-page="./NuevoProducto"
                    class="dropdown-item">

                        <i class="bi bi-box-seam me-2"></i>

                        Registrar producto nuevo

                    </a>
                </li>
            }

            <li>
                <a asp-page="./Agregar"
                class="dropdown-item">

                    <i class="bi bi-box-arrow-in-down me-2"></i>

                    Agregar producto existente

                </a>
            </li>

        </ul>

    </div>
</div>

@if (TempData["MensajeExito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (Model.EsAdministrador)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  class="row align-items-end">

                <div class="col-md-5">

                    <label asp-for="SucursalId"
                           class="form-label">
                        Filtrar por sucursal
                    </label>

                    <select asp-for="SucursalId"
                            asp-items="Model.ListaSucursales"
                            class="form-select">

                        <option value="">
                            Todas las sucursales
                        </option>

                    </select>

                </div>

                <div class="col-md-auto mt-3 mt-md-0">

                    <button type="submit"
                            class="btn btn-dark">

                        <i class="bi bi-funnel"></i>
                        Filtrar

                    </button>

                    <a asp-page="./Index"
                       class="btn btn-light">

                        Limpiar

                    </a>

                </div>

            </form>

        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">

        @if (!Model.Inventarios.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam fs-1 text-muted"></i>

                @if (Model.EsAdministrador && Model.SucursalId.HasValue)
                {
                    <h4 class="mt-3">
                        No hay productos en esta sucursal
                    </h4>

                    <p class="text-muted">
                        La sucursal seleccionada todavía no tiene productos registrados.
                    </p>
                }
                else
                {
                    <h4 class="mt-3">
                        No hay productos en el inventario
                    </h4>

                    <p class="text-muted">
                        Agrega productos al inventario de la sucursal.
                    </p>
                }

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Sucursal</th>
                            <th>Stock</th>
                            <th>Stock mínimo</th>
                            <th>Estado</th>
                            <th>Actualización</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var inventario in Model.Inventarios)
                        {
                            var stockBajo =
                                inventario.Stock <= inventario.StockMinimo;

                                <tr class="@(inventario.Stock == 0
                                    ? "table-danger"
                                    : stockBajo
                                        ? "table-warning"
                                        : string.Empty)">
                                <td>
                                    <div>
                                        <strong>
                                            @inventario.Producto.Nombre
                                        </strong>

                                        <div class="small text-muted">
                                            @inventario.Producto.Codigo
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @inventario.Sucursal.Nombre
                                </td>

                                <td>
                                    <span class="fw-bold">
                                        @inventario.Stock
                                    </span>
                                </td>

                                <td>
                                    @inventario.StockMinimo
                                </td>

                                <td>
                                    @if (inventario.Stock == 0)
                                    {
                                        <form method="post"
                                            asp-page-handler="Retirar"
                                            class="d-inline">

                                            <input type="hidden"
                                                name="id"
                                                value="@inventario.Id" />

                                            <input type="hidden"
                                                name="sucursalId"
                                                value="@Model.SucursalId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('¿Deseas retirar este producto de la sucursal? El producto continuará existiendo en el catálogo.');">

                                                <i class="bi bi-box-arrow-up"></i>
                                                Retirar

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled
                                                title="El stock debe estar en cero para retirar el producto">

                                            <i class="bi bi-box-arrow-up"></i>
                                            Retirar

                                        </button>
                                    }
                                </td>

                                <td>
                                    @inventario.FechaActualizacion.ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td class="text-end">

                                    <a asp-page="./Editar"
                                    asp-route-id="@inventario.Id"
                                    class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-pencil"></i>
                                        Editar

                                    </a>

                                    @if (inventario.Stock == 0)
                                    {
                                        <form method="post"
                                            asp-page-handler="Retirar"
                                            class="d-inline">

                                            <input type="hidden"
                                                name="id"
                                                value="@inventario.Id" />

                                            <input type="hidden"
                                                name="sucursalId"
                                                value="@Model.SucursalId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('¿Deseas retirar este producto de la sucursal? El producto continuará existiendo en el catálogo.');">

                                                <i class="bi bi-box-arrow-up"></i>
                                                Retirar

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                disabled
                                                title="El stock debe estar en cero para retirar el producto">

                                            <i class="bi bi-box-arrow-up"></i>
                                            Retirar

                                        </button>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>