@page
@model FerreteriaRazor.Pages.Inventario.IndexModel
@using System.Text.Json

@{
    ViewData["Title"] = "Inventario por sucursal";

    var opcionesJson = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var inventariosJson = JsonSerializer.Serialize(
        Model.Inventarios.Select(i => new
        {
            i.Id,
            Nombre = i.Producto.Nombre,
            Codigo = i.Producto.Codigo,
            Sucursal = i.Sucursal.Nombre,
            i.Stock,
            i.StockMinimo,
            FechaTexto = i.FechaActualizacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
            FechaOrden = i.FechaActualizacion.Ticks
        }),
        opcionesJson);
}

<link rel="stylesheet" href="~/js/tablas/inventario-tabla/inventario-tabla.css" asp-append-version="true" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">
            Inventario por sucursal
        </h1>

        <p class="text-muted mb-0">
            Consulta y administra las existencias de productos.
        </p>
    </div>

    <div class="dropdown">

        <button class="btn-primary-ferreteria dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">

            <i class="bi bi-plus-lg"></i>
            Agregar producto

        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
            @if (User.IsInRole("Administrador"))
            {
                <li>
                    <a asp-page="./NuevoProducto"
                    class="dropdown-item">

                        <i class="bi bi-box-seam me-2"></i>

                        Registrar producto nuevo

                    </a>
                </li>
            }

            <li>
                <a asp-page="./Agregar"
                class="dropdown-item">

                    <i class="bi bi-box-arrow-in-down me-2"></i>

                    Agregar producto existente

                </a>
            </li>

        </ul>

    </div>
</div>

@if (TempData["MensajeExito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>
    </div>
}

@if (Model.EsAdministrador)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <form method="get"
                  class="row align-items-end">

                <div class="col-md-5">

                    <label asp-for="SucursalId"
                           class="form-label">
                        Filtrar por sucursal
                    </label>

                    <select asp-for="SucursalId"
                            asp-items="Model.ListaSucursales"
                            class="form-select">
                    </select>

                </div>

                <div class="col-md-auto mt-3 mt-md-0">

                    <button type="submit"
                            class="btn btn-dark">

                        <i class="bi bi-funnel"></i>
                        Filtrar

                    </button>

                    <a asp-page="./Index"
                       class="btn btn-light">

                        Limpiar

                    </a>

                </div>

            </form>

        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">

        @if (!Model.Inventarios.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-box-seam fs-1 text-muted"></i>

                @if (Model.EsAdministrador && Model.SucursalId.HasValue)
                {
                    <h4 class="mt-3">
                        No hay productos en esta sucursal
                    </h4>

                    <p class="text-muted">
                        La sucursal seleccionada todavía no tiene productos registrados.
                    </p>
                }
                else
                {
                    <h4 class="mt-3">
                        No hay productos en el inventario
                    </h4>

                    <p class="text-muted">
                        Agrega productos al inventario de la sucursal.
                    </p>
                }

            </div>
        }
        else
        {
            <div id="inventario-tabla-root"
                 data-editar-url-base="@Url.Page("./Editar")?id=">
            </div>

            <script type="application/json" id="inventarios-data">@Html.Raw(inventariosJson)</script>
        }

    </div>
</div>

@section Scripts {
    <script src="~/js/tablas/inventario-tabla/inventario-tabla.js" asp-append-version="true"></script>
}