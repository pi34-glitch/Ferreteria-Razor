@page
@model FerreteriaRazor.Pages.Inventario.AgregarModel

@{
    ViewData["Title"] = "Agregar producto existente";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="d-flex align-items-center mb-4">

            <a asp-page="./Index"
                class="btn btn-light me-3"
                title="Volver al inventario"
                aria-label="Volver al inventario">

                    <i class="bi bi-arrow-left"></i>
            </a>

            <div>
                <h1 class="h3 mb-1">
                    Agregar producto existente
                </h1>

                <p class="text-muted mb-0">
                    Selecciona un producto del catálogo y agrégalo al inventario de una sucursal.
                </p>
            </div>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <form method="post">

                    <div asp-validation-summary="ModelOnly"
                        class="alert alert-danger"
                        role="alert">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.ProductoId"
                                   class="form-label">
                            </label>

                            <select asp-for="Input.ProductoId"
                                    asp-items="Model.ListaProductos"
                                    class="form-select">

                                <option value="">
                                    Seleccione un producto del catálogo
                                </option>

                            </select>

                            <span asp-validation-for="Input.ProductoId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.SucursalId"
                                   class="form-label">
                            </label>

                            @if (Model.EsAdministrador)
                            {
                                <select asp-for="Input.SucursalId"
                                        asp-items="Model.ListaSucursales"
                                        class="form-select">

                                    <option value="">
                                        Seleccione una sucursal
                                    </option>

                                </select>
                            }
                            else
                            {
                                <input type="hidden"
                                       asp-for="Input.SucursalId" />

                                <input type="text"
                                       value="@Model.NombreSucursalGerente"
                                       class="form-control"
                                       readonly />
                            }

                            <span asp-validation-for="Input.SucursalId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.Stock"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Stock"
                                type="number"
                                class="form-control"
                                min="0"
                                step="1" />
                            <span asp-validation-for="Input.Stock"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.StockMinimo"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.StockMinimo"
                                type="number"
                                class="form-control"
                                min="0"
                                step="1" />

                            <div class="form-text">
                                El sistema mostrará una alerta cuando el stock sea igual o menor a este valor.
                            </div>
                            
                            <span asp-validation-for="Input.StockMinimo"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    @if (!Model.EsAdministrador)
                    {
                        <div class="alert alert-info">

                            <i class="bi bi-building me-2"></i>

                            El producto será agregado al inventario de
                            <strong>@Model.NombreSucursalGerente</strong>.

                        </div>
                    }

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-page="./Index"
                           class="btn btn-light"
                           title="Cancelar"
                           aria-label="Cancelar">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-box-arrow-in-down"></i>
                            Agregar producto existente

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}