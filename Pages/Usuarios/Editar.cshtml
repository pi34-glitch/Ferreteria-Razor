@page "{id}"
@model FerreteriaRazor.Pages.Usuarios.EditarModel

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="d-flex align-items-center mb-4">

            <a asp-page="./Index"
               class="btn btn-light me-3">
                <i class="bi bi-arrow-left"></i>
            </a>

            <div>
                <h1 class="h3 mb-1">
                    Editar usuario
                </h1>

                <p class="text-muted mb-0">
                    Modifica la información, el rol y la sucursal.
                </p>
            </div>

        </div>

        <div class="card border-0 shadow-sm">

            <div class="card-body p-4">

                <form method="post">

                    <input type="hidden"
                           asp-for="Input.Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.NombreCompleto"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.NombreCompleto"
                                   class="form-control" />

                            <span asp-validation-for="Input.NombreCompleto"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.Usuario"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Usuario"
                                   class="form-control" />

                            <span asp-validation-for="Input.Usuario"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.Correo"
                                   class="form-label">
                            </label>

                            <input asp-for="Input.Correo"
                                   class="form-control" />

                            <span asp-validation-for="Input.Correo"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.Rol"
                                   class="form-label">
                            </label>

                            <select asp-for="Input.Rol"
                                    asp-items="Model.ListaRoles"
                                    class="form-select">

                                <option value="">
                                    Seleccione un rol
                                </option>

                            </select>

                            <span asp-validation-for="Input.Rol"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label asp-for="Input.SucursalId"
                                   class="form-label">
                            </label>

                            <select asp-for="Input.SucursalId"
                                    asp-items="Model.ListaSucursales"
                                    class="form-select">

                                <option value="">
                                    Seleccione una sucursal
                                </option>

                            </select>

                            <span asp-validation-for="Input.SucursalId"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label d-block">
                                Estado
                            </label>

                            <div class="form-check form-switch mt-2">

                                <input asp-for="Input.Activo"
                                       class="form-check-input" />

                                <label asp-for="Input.Activo"
                                       class="form-check-label">
                                </label>

                            </div>

                        </div>

                    </div>

                    <div class="alert alert-warning mt-2">

                        <i class="bi bi-info-circle me-2"></i>

                        Al cambiar el rol, la sucursal o el estado,
                        el usuario deberá iniciar sesión nuevamente.

                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-page="./Index"
                           class="btn btn-light">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-warning">

                            <i class="bi bi-save"></i>
                            Guardar cambios

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}