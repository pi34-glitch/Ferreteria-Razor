@page
@model FerreteriaRazor.Pages.Usuarios.IndexModel

@{
    ViewData["Title"] = "Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Usuarios</h1>

        <p class="text-muted mb-0">
            Administra gerentes y empleados de las sucursales.
        </p>
    </div>

    <a asp-page="./Crear"
       class="btn btn-warning">
        <i class="bi bi-person-plus"></i>
        Nuevo usuario
    </a>
</div>

@if (TempData["MensajeExito"] is not null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle me-2"></i>

        @TempData["MensajeExito"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

@if (TempData["MensajeError"] is not null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle me-2"></i>

        @TempData["MensajeError"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">

        @if (!Model.Usuarios.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-people fs-1 text-muted"></i>

                <h4 class="mt-3">
                    No hay usuarios registrados
                </h4>
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Correo</th>
                            <th>Rol</th>
                            <th>Sucursal</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var usuario in Model.Usuarios)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @usuario.NombreCompleto
                                    </strong>
                                </td>

                                <td>
                                    @usuario.Usuario
                                </td>

                                <td>
                                    @usuario.Correo
                                </td>

                                <td>
                                    @if (usuario.Rol == "Administrador")
                                    {
                                        <span class="badge bg-danger">
                                            Administrador
                                        </span>
                                    }
                                    else if (usuario.Rol == "Gerente")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Gerente
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @usuario.Rol
                                        </span>
                                    }
                                </td>

                                <td>
                                    @usuario.Sucursal
                                </td>

                                <td>
                                    @if (usuario.Activo)
                                    {
                                        <span class="badge bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td class="text-end">

                                    @if (!usuario.EsAdministrador)
                                    {
                                        <a asp-page="./Editar"
                                           asp-route-id="@usuario.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="bi bi-pencil"></i>
                                            Editar

                                        </a>

                                        <form method="post"
                                              asp-page-handler="CambiarEstado"
                                              class="d-inline">

                                            <input type="hidden"
                                                   name="id"
                                                   value="@usuario.Id" />

                                            @if (usuario.Activo)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        onclick="return confirm('¿Deseas desactivar este usuario?');">

                                                    <i class="bi bi-person-x"></i>
                                                    Desactivar

                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">

                                                    <i class="bi bi-person-check"></i>
                                                    Activar

                                                </button>
                                            }

                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            Usuario protegido
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>
</div>