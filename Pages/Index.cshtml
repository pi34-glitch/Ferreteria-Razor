@page
@model FerreteriaRazor.Pages.IndexModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var opcionesJson = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var datosJson = JsonSerializer.Serialize(Model.Datos, opcionesJson);

    // /Inventario/Editar usa @page "{id:int}" (el id va como segmento de
    // ruta, no como query string), así que hace falta generar la URL con
    // un id "de mentira" y recortarlo para quedarnos con la base.
    var editarInventarioUrlBase = Url.Page("/Inventario/Editar", new { id = 0 })!;
    editarInventarioUrlBase = editarInventarioUrlBase.Substring(0, editarInventarioUrlBase.Length - 1);
}

<link rel="stylesheet" href="~/js/dashboard/dashboard.css" asp-append-version="true" />

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <span class="badge bg-primary mb-3">
                        Panel administrativo
                    </span>

                    <h1 class="h3 fw-bold mb-2">
                        Bienvenido a La Llave Nuda
                    </h1>

                    <p class="text-muted mb-0">
                        Consulta el estado del catálogo y del inventario
                        de todas las sucursales.
                    </p>

                </div>

                <div class="col-lg-4 mt-4 mt-lg-0">

                    <div class="d-flex flex-wrap justify-content-lg-end gap-2">

                        <a asp-page="/Inventario/NuevoProducto"
                           class="btn btn-primary">

                            <i class="bi bi-plus-circle me-1"></i>
                            Registrar producto

                        </a>

                        <a asp-page="/Inventario/Agregar"
                           class="btn btn-outline-primary">

                            <i class="bi bi-box-arrow-in-down me-1"></i>
                            Producto existente

                        </a>

                        <a asp-page="/Inventario/Index"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-boxes me-1"></i>
                            Ver inventario

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div id="dashboard-widgets-root"
         data-datos-url="@Url.Page(null, "Datos")"
         data-catalogo-url="@Url.Page("/Productos/Index")"
         data-inventario-url="@Url.Page("/Inventario/Index")"
         data-editar-inventario-url-base="@editarInventarioUrlBase">
    </div>

    <script type="application/json" id="dashboard-datos">@Html.Raw(datosJson)</script>

    <!-- Productos recientes -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 pt-4 px-4">

            <div class="d-flex flex-wrap
                        justify-content-between
                        align-items-center gap-3">

                <div>
                    <h2 class="h5 fw-bold mb-1">
                        Productos recientes
                    </h2>

                    <p class="text-muted small mb-0">
                        Últimos productos registrados en el catálogo
                    </p>
                </div>

                <a asp-page="/Inventario/NuevoProducto"
                   class="btn btn-primary">

                    <i class="bi bi-plus-lg me-1"></i>
                    Nuevo producto

                </a>

            </div>

        </div>

        <div class="card-body px-4">

            @if (!Model.ProductosRecientes.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-box-seam
                              text-muted display-5">
                    </i>

                    <h3 class="h6 fw-bold mt-3">
                        No hay productos registrados
                    </h3>

                    <p class="text-muted mb-0">
                        Los productos recientes aparecerán aquí.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Categoría</th>
                                <th>Marca</th>
                                <th>Precio</th>
                                <th>Stock total</th>
                                <th>Registro</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var producto in Model.ProductosRecientes)
                            {
                                <tr>

                                    <td>

                                        <div class="d-flex
                                                    align-items-center
                                                    gap-3">

                                            @if (!string.IsNullOrWhiteSpace(
                                                producto.ImagenUrl))
                                            {
                                                <img src="@producto.ImagenUrl"
                                                     alt="@producto.Nombre"
                                                     width="48"
                                                     height="48"
                                                     class="rounded border"
                                                     style="object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="rounded border
                                                            bg-light
                                                            d-flex
                                                            align-items-center
                                                            justify-content-center"
                                                     style="width: 48px;
                                                            height: 48px;">

                                                    <i class="bi bi-image
                                                              text-muted">
                                                    </i>

                                                </div>
                                            }

                                            <div>

                                                <strong class="d-block">
                                                    @producto.Nombre
                                                </strong>

                                                <small class="text-muted">
                                                    @producto.Codigo
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <td>
                                        @producto.Categoria
                                    </td>

                                    <td>
                                        @producto.Marca
                                    </td>

                                    <td class="fw-semibold">
                                        Bs @producto.Precio.ToString("N2")
                                    </td>

                                    <td>

                                        @if (producto.StockTotal == 0)
                                        {
                                            <span class="badge bg-danger">
                                                Sin stock
                                            </span>
                                        }
                                        else if (producto.TieneStockBajo)
                                        {
                                            <span class="badge
                                                         bg-warning
                                                         text-dark">
                                                @producto.StockTotal unidades
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                @producto.StockTotal unidades
                                            </span>
                                        }

                                    </td>

                                    <td>
                                        @(producto.FechaRegistro.ToLocalTime().ToString("dd/MM/yyyy"))
                                    </td>

                                    <td class="text-end">

                                        <a asp-page="/Productos/Details"
                                           asp-route-id="@producto.ProductoId"
                                           class="btn btn-sm
                                                  btn-outline-secondary"
                                           title="Ver producto">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard/dashboard.js" asp-append-version="true"></script>
}